{
  "name": "claude-code-trace",
  "version": "0.13.0",
  "private": true,
  "bin": {
    "cctrace": "./bin/cctrace.mjs"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "dev:web": "tauri dev -- -- --web",
    "dev:tui": "tauri dev -- -- --headless & pip install -r tui-py/requirements.txt -q && node bin/wait-for-backend.mjs && python3 tui-py/main.py",
    "lint": "oxlint && cargo clippy --manifest-path src-tauri/Cargo.toml",
    "fmt": "oxfmt && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "fmt:check": "oxfmt --check && cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "test": "vitest run && cargo test --manifest-path src-tauri/Cargo.toml",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "tsc --noEmit && oxlint && oxfmt --check && cargo clippy --manifest-path src-tauri/Cargo.toml && cargo fmt --manifest-path src-tauri/Cargo.toml --check && vitest run && cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-fs": "^2",
    "@tauri-apps/plugin-opener": "2.5.4",
    "@testing-library/dom": "^10.4.1",
    "@thesvg/react": "3.3.1",
    "@types/marked-terminal": "^6.1.1",
    "marked": "15.0.12",
    "marked-terminal": "^7.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "react-virtuoso": "^4.18.12",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "~1.56.0",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/react-syntax-highlighter": "^15.5.0",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
